APP_NAME=Convenience Stock Watcher
DATABASE_URL=postgresql+psycopg://stock:stock@db:5432/stock
# Device login: each new device enters this password once, then stays trusted.
# Required -- if empty, nobody can log in. Use a long random value.
AUTH_PASSWORD=
AUTH_DEVICE_DAYS=365
# true only when served over HTTPS (otherwise the cookie is never sent).
AUTH_COOKIE_SECURE=false

# Host port for the web UI (change if 8000 is already used on the host).
APP_PORT=8000

DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Restock watcher scheduler (polls due watches; alerts to log + /watches screen).
WATCHER_ENABLED=true
WATCHER_POLL_SECONDS=60
WATCHER_DEFAULT_INTERVAL_SECONDS=300
# Per-tick budget: MAX_CHECKS_PER_TICK must cover
# (활성 감시 수 / 감시 간격) * POLL_SECONDS, and CONCURRENCY must be high
# enough that the batch finishes inside POLL_SECONDS.
WATCHER_MAX_CHECKS_PER_TICK=120
WATCHER_CONCURRENCY=12

# GS25 product search (unofficial woodongs total-search endpoint).
# Set GS25_SEARCH_ENABLED=false to skip all live network calls.
GS25_SEARCH_ENABLED=true
GS25_API_BASE_URL=https://b2c-apigw.woodongs.com
GS25_SEARCH_PATH=/search/v3/totalSearch
GS25_REQUEST_TIMEOUT=10.0
GS25_SEARCH_LIMIT=20

# GS25 real-time store stock lookup (itemCode + coordinates).
GS25_STOCK_ENABLED=true
GS25_BFF_BASE_URL=https://b2c-bff.woodongs.com
GS25_STOCK_PATH=/api/bff/v2/store/stock
# Default search center for the "실제 재고 조회" button (Seoul City Hall).
GS25_DEFAULT_LATITUDE=37.5665
GS25_DEFAULT_LONGITUDE=126.9780
GS25_DEFAULT_RADIUS_METERS=1000
# Stock BFF requires a woodongs app bearer token (capture from the app/web).
# Leave blank to keep stock lookups as a graceful failure.
GS25_AUTH_TOKEN=

# Shared HTTP timeout for 7-Eleven / Emart24 / CU adapters (seconds).
ADAPTER_REQUEST_TIMEOUT=10.0

# 7-Eleven product search (public /open/ endpoint, no auth).
SEVENELEVEN_SEARCH_ENABLED=true
SEVENELEVEN_BASE_URL=https://new.7-elevenapp.co.kr
SEVENELEVEN_SEARCH_PATH=/api/v1/open/search/goods
SEVENELEVEN_SEARCH_LIMIT=30
# 7-Eleven real-time stock (itemCd -> smCd meta -> store search -> real-stock).
SEVENELEVEN_STOCK_ENABLED=true
SEVENELEVEN_STORE_LIMIT=30
SEVENELEVEN_DEFAULT_STORE_KEYWORD=강남

# Emart24 product search (public everse endpoint, no auth).
EMART24_SEARCH_ENABLED=true
EMART24_BASE_URL=https://everse.emart24.co.kr
EMART24_SEARCH_PATH=/stock/stock/search
EMART24_SEARCH_LIMIT=20
# Emart24 real-time stock (pluCd + store keyword -> bizNo list -> qty).
EMART24_STOCK_ENABLED=true
EMART24_WEB_BASE_URL=https://emart24.co.kr
EMART24_STORE_LIMIT=30
EMART24_DEFAULT_STORE_KEYWORD=강남

# CU (포켓CU) product search + coordinate stock (public web API, no auth).
CU_SEARCH_ENABLED=true
CU_STOCK_ENABLED=true
CU_BASE_URL=https://www.pocketcu.co.kr
CU_SEARCH_LIMIT=20
CU_MAX_RADIUS_METERS=1000
